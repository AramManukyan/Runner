# Runner API auth — same value as RUNNER_API_KEY secret in Agent Control
RUNNER_API_KEY=
# HMAC secret for callbacks — same value as RUNNER_CALLBACK_SECRET in Agent Control
RUNNER_CALLBACK_SECRET=
# Only allow callbacks to your app origin (comma-separated)
ALLOWED_CALLBACK_ORIGINS=https://your-app.lovable.app
# Claude Agent SDK
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5
AGENT_MAX_TURNS=40
# Limits
MAX_CONCURRENT_JOBS=2
MAX_TIME_LIMIT_SEC=3600
MAX_LOG_BYTES=1000000
# Per-repository git tokens referenced by tokenEnv in repos.json
GIT_TOKEN_DEMO=
MAX_TOKENS_CAP=2000000
MAX_COST_USD_CAP=20
